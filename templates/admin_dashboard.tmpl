{{define "admin_dashboard_title"}}Administration (Dashboard){{end}}
{{define "admin_dashboard_body"}}
<div class="paste-toolbox">
	{{template "home-button"}}
	<span class="paste-title">
		<strong>Administration (Dashboard)</strong>
	</span>
</div>
<div class="content admin-content">
	<div class="well admin-links">
		<a class="btn" href="/admin">Admin Home</a>
		<a class="btn" href="/admin/reports">Reports</a>
		<a class="btn" href="/admin/pastes">Pastes</a>
		<a class="btn" href="/admin/users">Users</a>
	</div>

	<div class="admin-cards">
		<div class="well admin-card">
			<div class="admin-kpi-label">Pastes</div>
			<div class="admin-kpi-value">{{.Obj.Dashboard.TotalPastes}}</div>
		</div>
		<div class="well admin-card">
			<div class="admin-kpi-label">Reports</div>
			<div class="admin-kpi-value">{{.Obj.Dashboard.TotalReports}}</div>
		</div>
		<div class="well admin-card">
			<div class="admin-kpi-label">Users</div>
			<div class="admin-kpi-value">{{.Obj.Dashboard.TotalUsers}}</div>
		</div>
		<div class="well admin-card">
			<div class="admin-kpi-label">Admins</div>
			<div class="admin-kpi-value">{{.Obj.Dashboard.TotalAdmins}}</div>
		</div>
		<div class="well admin-card">
			<div class="admin-kpi-label">Expiring</div>
			<div class="admin-kpi-value">{{.Obj.Dashboard.ExpiringPastes}}</div>
		</div>
	</div>

	<div class="well">
		<div class="well-title">Admin role management moved</div>
		Use <a href="/admin/users">Users</a> to promote or remove admin access.
	</div>

	<h4>Recent Reports</h4>
	<ul class="report-list">
		{{range $row := .Obj.RecentReports}}<li>
			<div class="report-buttons">
				<a title="View Paste" href="/paste/{{$row.PasteID}}" target="_blank" class="btn btn-link"><i class="icon-file-text"></i></a>
				<form action="/admin/paste/{{$row.PasteID}}/delete?redir=reports" method="post">
					<button title="Delete Paste" type="submit" class="btn btn-link"><i class="icon-trash"></i></button>
				</form>
				<form action="/admin/paste/{{$row.PasteID}}/clear_report" method="post">
					<button title="Clear Report" type="submit" class="btn btn-link"><i class="icon-cancel"></i></button>
				</form>
			</div>
			<div class="report-contents">
				<span class="paste-title">
					<strong>{{$row.PasteID}}</strong>
					<span class="paste-subtitle">{{range $reason := $row.Reasons}}{{$reason}} {{end}}</span>
				</span>
			</div>
			<div class="clearfix"></div>
		</li>{{else}}
		<div class="well">No reports.</div>
		{{end}}
	</ul>
</div>
{{end}}
