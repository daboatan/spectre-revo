{{define "admin_users_title"}}Administration (Users){{end}}
{{define "admin_users_body"}}
<div class="paste-toolbox">
	{{template "home-button"}}
	<span class="paste-title">
		<strong>Administration (Users)</strong>
	</span>
</div>
<div class="content admin-content">
	<div class="well admin-links">
		<a class="btn" href="/admin">Admin Home</a>
		<a class="btn" href="/admin/reports">Reports</a>
		<a class="btn" href="/admin/pastes">Pastes</a>
	</div>

	<form class="well admin-filter-row" method="GET" action="/admin/users">
		<div class="input-prepend phone-expand">
			<span class="add-on"><i class="icon icon-search"></i></span>
			<div class="input-wrapper"><input type="text" name="q" value="{{.Obj.Query}}" placeholder="Search users"></div>
		</div>
		<label class="checkbox">
			<input type="checkbox" name="admin" value="1" {{if .Obj.AdminOnly}}checked{{end}}> Admin only
		</label>
		<button class="btn btn-inverse" type="submit">Apply</button>
	</form>

	{{if .Obj.Users}}
	<div class="well">
		<table class="admin-users-table">
			<thead>
				<tr>
					<th class="admin-user-name">User</th>
					<th class="admin-user-role">Role</th>
					<th class="admin-user-persona">Persona</th>
					<th class="admin-user-action">Action</th>
				</tr>
			</thead>
			<tbody>
				{{range $row := .Obj.Users}}
				<tr>
					<td class="admin-user-name"><strong>{{$row.Name}}</strong></td>
					<td class="admin-user-role">{{if $row.IsAdmin}}admin{{else}}user{{end}}</td>
					<td class="admin-user-persona">{{if $row.IsPersona}}yes{{else}}no{{end}}</td>
					<td class="admin-user-action">
						{{if $row.IsAdmin}}
						<form action="/admin/demote" method="post">
							<input type="hidden" name="username" value="{{$row.Name}}">
							<input type="hidden" name="redir" value="users">
							<button type="submit" class="btn btn-link">Remove admin</button>
						</form>
						{{else}}
						<form action="/admin/promote" method="post">
							<input type="hidden" name="username" value="{{$row.Name}}">
							<input type="hidden" name="redir" value="users">
							<button type="submit" class="btn btn-link">Promote admin</button>
						</form>
						{{end}}
					</td>
				</tr>
				{{end}}
			</tbody>
		</table>
	</div>
	{{else}}
	<div class="well">No users found.</div>
	{{end}}
</div>
{{end}}
